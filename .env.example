# PagerDuty
PAGERDUTY_TOKEN=
PAGERDUTY_USER_TOKEN=
PD_REGION=US
PD_DOMAIN=

# Customer
POV_CUSTOMER_NAME=
POV_USER_EMAIL=
# Business service subscriber emails (comma-separated, optional)
# Users must already exist in PagerDuty; they will be subscribed to all business services.
BUSINESS_SERVICE_SUBSCRIBER_EMAILS=

# Slack (optional)
SLACK_ENABLED=false
SLACK_TOKEN=
SLACK_WORKSPACE_ID=

# Grafana (optional)
GRAFANA_ENABLED=false
GRAFANA_URL=
GRAFANA_TOKEN=
GRAFANA_LOKI_DS_NAME=
GRAFANA_PROMETHEUS_DS_NAME=

# Rollback Incident Workflow (optional)
ROLLBACK_ENABLED=false
ROLLBACK_WEBHOOK_URL=

# Major Incident Workflow (optional)
MAJOR_INCIDENT_ENABLED=false

# Per-Incident Slack Channel Workflow (optional)
CHANNEL_WORKFLOW_ENABLED=false

# Grafana Cloud telemetry credentials (for seeding metrics/logs/traces)
LOKI_URL=
LOKI_USERNAME=
LOKI_API_KEY=
ALLOY_URL=
ALLOY_USERNAME=
ALLOY_API_KEY=
TEMPO_URL=
TEMPO_USERNAME=
TEMPO_API_KEY=
